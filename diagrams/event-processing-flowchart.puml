@startuml file_conversion_flowchart
title Обработка событий в сервисе конвертации файлов — вариант 26

start

repeat
  partition "Календарь событий" {
    :Взять ближайшее событие;
  }

  if (Поступила новая заявка?) then (да)
    partition "Источник заявок" {
      :Создать заявку [ИБ];
      :Назначить следующее поступление\nс равномерным интервалом [ИЗ2];
    }

    partition "Диспетчер постановки" {
      :Найти первое свободное место\nбез сдвига заявок [Д1ОЗ3];
    }

    if (Свободное место есть?) then (да)
      partition "Буфер" {
        :Поставить новую заявку\nв найденную ячейку;
      }
    else (нет)
      partition "Буфер" {
        :Извлечь заявку, поступившую\nв буфер последней [Д1ОО4];
      }
      partition "Статистика" {
        :Учесть отказ вытесненной заявки;
      }
      partition "Буфер" {
        :Поставить новую заявку\nв освободившуюся ячейку;
      }
    endif

  else (завершена обработка)
    partition "Обработчик" {
      :Завершить конвертацию;
      :Освободиться;
    }
    partition "Статистика" {
      :Учесть обработанную заявку\nи время её пребывания в системе;
    }
  endif

  partition "Диспетчер выбора" {
    :Проверить буфер и пул обработчиков;
  }

  while (Есть ожидающая заявка\nи свободный обработчик?) is (да)
    partition "Диспетчер выбора" {
      :Выбрать свободного обработчика\nпо кольцу [Д2П2];
      :Выбрать заявку из буфера\nпо кольцу [Д2Б3];
    }

    partition "Буфер" {
      :Извлечь выбранную заявку;
    }

    partition "Диспетчер выбора" {
      :Сдвинуть оба независимых указателя;
    }

    partition "Обработчик" {
      :Начать конвертацию;
      :Определить экспоненциальное\nвремя обработки [ПЗ1];
    }

    partition "Календарь событий" {
      :Запланировать событие\nзавершения обработки;
    }
  endwhile (нет)

  partition "Отображение" {
    :Показать состояние источника,\nбуфера, обработчиков и указателей;
    :Показать календарь событий\nи долю отказов [ОД2];
  }

repeat while (Есть события в пределах\nвремени моделирования?) is (да) not (нет)

partition "Отображение" {
  :Показать сводную таблицу\nрезультатов [ОР1];
}
stop

@enduml